<?xml version="1.0" encoding="utf-8"?>
<!-- Card background for the home tile. A shape, not a theme, because
     RemoteViews layouts cannot reference app themes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E61F2B2B" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#4DB6AC" />
</shape>
